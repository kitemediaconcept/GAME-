// ─── 7. BALL ─────────────────────────────────────────────────
const ball = new THREE.Group();
(function () {
  const whiteMat = new THREE.MeshStandardMaterial({ color:0xf0ede8, roughness:0.72, metalness:0 });
  const blackMat = new THREE.MeshStandardMaterial({ color:0x1a1a1a, roughness:0.85, metalness:0 });
  const s=0.101, lw=0.007, phi=(1+Math.sqrt(5))/2;
  const ba=0,bb=s,bc=2*s,bd=phi*s,be=3*bd,bf=(1+2*phi)*s,bg=(2+phi)*s,bh=2*phi*s;
  const cords=[
    [+ba,+bb,+be],[+ba,+bb,-be],[+ba,-bb,+be],[+ba,-bb,-be],[+bb,+be,+ba],[+bb,-be,+ba],
    [-bb,+be,+ba],[-bb,-be,+ba],[+be,+ba,+bb],[-be,+ba,+bb],[+be,+ba,-bb],[-be,+ba,-bb],
    [+bc,+bf,+bd],[+bc,+bf,-bd],[+bc,-bf,+bd],[-bc,+bf,+bd],[+bc,-bf,-bd],[-bc,+bf,-bd],
    [-bc,-bf,+bd],[-bc,-bf,-bd],[+bf,+bd,+bc],[+bf,-bd,+bc],[-bf,+bd,+bc],[+bf,+bd,-bc],
    [-bf,-bd,+bc],[+bf,-bd,-bc],[-bf,+bd,-bc],[-bf,-bd,-bc],[+bd,+bc,+bf],[-bd,+bc,+bf],
    [+bd,+bc,-bf],[+bd,-bc,+bf],[-bd,+bc,-bf],[-bd,-bc,+bf],[+bd,-bc,-bf],[-bd,-bc,-bf],
    [+bb,+bg,+bh],[+bb,+bg,-bh],[+bb,-bg,+bh],[-bb,+bg,+bh],[+bb,-bg,-bh],[-bb,+bg,-bh],
    [-bb,-bg,+bh],[-bb,-bg,-bh],[+bg,+bh,+bb],[+bg,-bh,+bb],[-bg,+bh,+bb],[+bg,+bh,-bb],
    [-bg,-bh,+bb],[+bg,-bh,-bb],[-bg,+bh,-bb],[-bg,-bh,-bb],[+bh,+bb,+bg],[-bh,+bb,+bg],
    [+bh,+bb,-bg],[+bh,-bb,+bg],[-bh,+bb,-bg],[-bh,-bb,+bg],[+bh,-bb,-bg],[-bh,-bb,-bg]
  ];
  const p0=new THREE.Vector3(0,0,0);
  const radius=new THREE.Vector3(...cords[0]).distanceTo(p0);
  ball.add(new THREE.Mesh(new THREE.SphereGeometry(radius*0.98,48,48),whiteMat));
  for (let i=0;i<cords.length;i++) for (let j=i+1;j<cords.length;j++) {
    const p1=new THREE.Vector3(...cords[i]),p2=new THREE.Vector3(...cords[j]);
    if (p1.distanceTo(p2)>bc*1.1) continue;
    const mid=new THREE.Vector3((cords[i][0]+cords[j][0])/2,(cords[i][1]+cords[j][1])/2,(cords[i][2]+cords[j][2])/2);
    const sc=p1.distanceTo(p0)/mid.distanceTo(p0);
    ball.add(new THREE.Mesh(new THREE.TubeGeometry(new THREE.QuadraticBezierCurve3(p1,new THREE.Vector3(mid.x*sc*sc,mid.y*sc*sc,mid.z*sc*sc),p2),8,lw,5,false),blackMat));
  }
  const fc=[[0,28,36,39,29],[1,32,41,37,30],[2,33,42,38,31],[3,34,40,43,35],
    [4,12,44,47,13],[5,16,49,45,14],[6,17,50,46,15],[7,18,48,51,19],
    [8,20,52,55,21],[9,24,57,53,22],[10,25,58,54,23],[11,26,56,59,27]];
  const idx=[];
  fc.forEach(f=>{for(let j=0;j<f.length-2;j++)idx.push(f[0],f[j+1],f[j+2]);});
  ball.add(new THREE.Mesh(new THREE.PolyhedronBufferGeometry(cords.flat(Infinity),idx,radius,3),blackMat));
})();
ball.position.set(0, 0.5, 0);
