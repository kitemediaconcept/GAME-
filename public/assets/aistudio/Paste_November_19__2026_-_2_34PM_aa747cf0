function updateBallShadow() {
  const h=Math.max(0,ball.position.y-0.5), hf=Math.max(0,1-h/5);
  ballShadow.position.x=ball.position.x-h*0.3;
  ballShadow.position.z=ball.position.z-h*0.2;
  ballShadow.scale.setScalar(0.5+hf*0.5);
  shadowMat.opacity=0.04+hf*0.28;
}

function createSparkle(x, y, z) {
  const mat = new THREE.MeshBasicMaterial({ color:0xffdd00, transparent:true, opacity:1 });
  const s = new THREE.Mesh(new THREE.SphereGeometry(0.08,4,4), mat);
  s.position.set(x,y,z);
  scene.add(s);
  gsap.to(s.scale,    { x:0, y:0, z:0, duration:0.6 });
  gsap.to(s.material, { opacity:0, duration:0.6, onComplete: () => scene.remove(s) });
}

